# ============================================================================
# Flight Deal Scanner Agent — Environment Configuration Template
# Copy this file to `.env` for local development. In production, credentials
# are loaded automatically from Google Cloud Secret Manager.
# ============================================================================

# Google Cloud & Vertex AI Runtime
GOOGLE_CLOUD_PROJECT="your_gcp_project_id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY="true"
OTEL_EXPORT_TO_CLOUD="false"

# Secret Manager Secret IDs (used when running in Cloud Run / Agent Engine)
GEMINI_API_KEY="your_gemini_api_key_here"
SERPAPI_API_KEY="your_serpapi_google_flights_key_here"
AMADEUS_API_KEY="your_amadeus_api_key_here"
AMADEUS_API_SECRET="your_amadeus_api_secret_here"
TRIP_COM_PARTNER_KEY="your_trip_com_partner_key_here"
SKYSCANNER_API_KEY="your_skyscanner_api_key_here"
KAYAK_PARTNER_TOKEN="your_kayak_partner_token_here"

# Strategic Model Routing
FAST_SCANNER_MODEL="gemini-2.5-flash"
COMPACTION_SUMMARIZER_MODEL="gemini-2.5-flash-lite"
REASONING_COORDINATOR_MODEL="gemini-2.5-pro"

# Persistent Session & Baseline Fare Storage
# Cloud Run / Prod: postgresql+asyncpg://scanner_user:PASSWORD@/flight_scanner?host=/cloudsql/PROJECT:REGION:INSTANCE
SESSION_SERVICE_URI="sqlite:///./data/flight_sessions.db"
FARE_HISTORY_DB_URL="sqlite:///./data/fare_history.db"
VERTEX_MEMORY_BANK_AGENT_ENGINE_ID=""

# Flight Scanning Domain Defaults
ALLOWED_ORIGINS="SNA,LAX"
TARGET_LEAD_DAYS="45"
LEAD_DAYS_FLEX_WINDOW="3"
MIN_TRIP_DURATION_DAYS="7"
MAX_TRIP_DURATION_DAYS="14"
SCAN_INTERVAL_HOURS="2"
ALERT_DROP_THRESHOLDS="0.30,0.40,0.50"
ALERT_NOTIFICATION_EMAIL="your_alert_email@example.com"
